# Domaine du service (utilisé pour référence, le routage réel se fait via nginx)
DOMAIN=<ton-domaine>

# URL de base utilisée dans les liens générés côté admin
BASE_URL=https://<ton-domaine>

# Mot de passe pour accéder à /admin (change-le !)
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session (change-le aussi, chaine aleatoire longue)
SESSION_SECRET=change-moi-aussi-une-longue-chaine-aleatoire

# ntfy : soit ton instance self-hostee, soit https://ntfy.sh (topic prive/aleatoire recommande)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=qrlf-remplace-par-un-nom-unique-imprevisible

PORT=3000
