# Domaine du service (utilisé pour référence, le routage réel se fait via nginx)
DOMAIN=<ton-domaine>

# URL de base utilisée dans les liens générés côté admin
# OBLIGATOIRE : l'application refuse de démarrer si cette variable est absente.
BASE_URL=https://<ton-domaine>

# Mot de passe pour accéder à /admin
# OBLIGATOIRE : l'application refuse de démarrer si cette variable est absente (pas de valeur par défaut).
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session (chaine aleatoire longue, 32+ caracteres)
# OBLIGATOIRE : l'application refuse de démarrer si cette variable est absente ou trop courte.
# Génère-en une avec : openssl rand -hex 32
SESSION_SECRET=change-moi-aussi-une-longue-chaine-aleatoire-32-caracteres-minimum

# ntfy : soit ton instance self-hostee, soit https://ntfy.sh
NTFY_URL=https://ntfy.sh
# OBLIGATOIRE : choisis un nom de topic imprévisible, l'application refuse de démarrer sinon.
NTFY_TOPIC=qrlf-remplace-par-un-nom-unique-imprevisible

PORT=3000

# Optionnel : purge automatique des scans/soumissions (donnees de localisation) au-dela
# de N jours. Laisse vide/absent pour conserver l'historique indefiniment.
# RETENTION_DAYS=90
